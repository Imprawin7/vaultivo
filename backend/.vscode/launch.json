{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Vaultivo (local)",
      "request": "launch",
      "mainClass": "com.vaultivo.VaultivoApplication",
      "projectName": "vaultivo-service",
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "5432",
        "DB_NAME": "vaultivo",
        "DB_USERNAME": "postgres",
        "DB_PASSWORD": "postgres",

        "JWT_SECRET": "local-dev-only-secret-change-me-32-bytes-minimum",

        "S3_BUCKET": "vaultivo-dev",
        "AWS_REGION": "us-east-1",
        "AWS_S3_ENDPOINT": "http://localhost:9000",
        "AWS_ACCESS_KEY_ID": "minioadmin",
        "AWS_SECRET_ACCESS_KEY": "minioadmin",

        "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
        "OAUTH2_REDIRECT_URI": "http://localhost:5173/oauth2/callback"

        // Google OAuth2 is optional for local testing — email/password auth
        // works out of the box. To also test "Sign in with Google" locally,
        // add real values here:
        // "GOOGLE_CLIENT_ID": "your-client-id",
        // "GOOGLE_CLIENT_SECRET": "your-client-secret"
      }
    }
  ]
}
